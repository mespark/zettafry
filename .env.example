# ---------------------------------------------------------------
# Zettafry — environment variables
# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Only VITE_* variables are readable in the browser.
# ---------------------------------------------------------------

# Firebase (Auth: Google sign-in) — browser safe
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:xxxxxxxxxx:web:xxxxxxxxxxxxxxxxxxxxxx

# Firebase Admin (server only — never prefix with VITE_)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Supabase — browser safe
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Supabase — server only
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key-server-only

#Your-Mail
VITE_ADMIN_EMAIL=your-email@example.com
